    let currentTab = "壽險";

    // 切換 壽險 / 產險 分類
    function setTab(type) {
      currentTab = type;
      const tabLife = document.getElementById("tab-life");
      const tabProperty = document.getElementById("tab-property");
      const badgeLife = document.getElementById("badge-life");
      const badgeProperty = document.getElementById("badge-property");
      const currentTypeLabel = document.getElementById("current-type-label");

      if (type === "壽險") {
        // 壽險選中狀態 (立體深色發光大按鈕)
        tabLife.className = "touch-btn relative py-4 sm:py-5 px-3 rounded-xl font-black flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 transition-all duration-200 bg-gradient-to-b from-cyan-500 to-teal-600 text-white shadow-lg shadow-cyan-900/25 border-b-4 border-teal-800 scale-[1.02]";
        tabLife.querySelector("div:first-child").className = "w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-2xl shrink-0";
        badgeLife.className = "text-[11px] font-bold text-teal-100 flex items-center justify-center sm:justify-start gap-1 mt-0.5";
        badgeLife.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-300 inline-block animate-pulse"></span><span>目前選取中</span>';

        // 產險未選中狀態 (立體白色按鈕)
        tabProperty.className = "touch-btn relative py-4 sm:py-5 px-3 rounded-xl font-black flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 transition-all duration-200 bg-white text-slate-600 hover:text-cyan-800 hover:bg-cyan-50/80 border-2 border-slate-300 border-b-4 border-b-slate-400 active:border-b-2 shadow-sm";
        tabProperty.querySelector("div:first-child").className = "w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-2xl shrink-0 text-slate-500";
        badgeProperty.className = "text-[11px] font-bold text-slate-400 flex items-center justify-center sm:justify-start gap-1 mt-0.5";
        badgeProperty.innerHTML = '<span>點我切換</span>';

        if (currentTypeLabel) currentTypeLabel.textContent = "壽險專區 (16家)";
      } else {

    // 渲染第一層：公司超大按鈕方塊 (加入更明顯的立體點選按鈕特徵)
    function renderCompanies() {
      const container = document.getElementById("company-grid");
      const list = DATA.filter(c => c.type === currentTab);

      container.innerHTML = list.map(c => `
        <button 
          onclick="openDetail('${c.id}')"
          class="touch-btn text-left p-4 sm:p-5 rounded-2xl bg-white border-2 border-cyan-300 hover:border-cyan-600 border-b-4 border-b-cyan-500 active:border-b-2 shadow-sm hover:shadow-md transition active:scale-[0.98] flex flex-col justify-between min-h-[120px] sm:min-h-[135px] group"
        >
          <div class="flex items-center justify-between w-full">
            <span class="font-mono text-xs font-black px-2.5 py-1 rounded-lg bg-cyan-100 text-cyan-900 border border-cyan-200">
              ${c.code}
            </span>
            <span class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
              ${c.items.length} 個連結
            </span>
          </div>
          <div class="mt-2">
            <div class="text-base sm:text-xl font-black text-slate-800 group-hover:text-cyan-700 transition leading-snug">
              ${c.name}
            </div>
            <div class="text-[11px] text-cyan-700 font-bold mt-1.5 flex items-center gap-1">
              <span>👆 點擊查看帳密與連結</span>
              <i class="ph-bold ph-caret-right"></i>
            </div>
          </div>
        </button>
      `).join("");
    }

    // 開啟第二層：單一公司細項
    function openDetail(companyId) {
      const company = DATA.find(c => c.id === companyId);
      if (!company) return;

      document.getElementById("view-home").classList.add("hidden");
      document.getElementById("view-detail").classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "instant" });

      document.getElementById("detail-badge").textContent = company.code;
      document.getElementById("detail-title").textContent = company.name;
      document.getElementById("detail-count-badge").textContent = `共 ${company.items.length} 個常用項目`;

      const container = document.getElementById("actions-container");

      container.innerHTML = company.items.map((item, index) => {
        const isLink = item.url && item.url !== "#";

        return `
          <div class="space-y-2">
            
            <!-- 1. 超大彩色點選按鈕 (統一標示 👉 點此開啟) -->
            ${isLink ? `
              <a 
                href="${item.url}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="touch-btn w-full py-4 px-5 rounded-2xl bg-gradient-to-r ${item.bg} text-white font-black text-base sm:text-lg shadow-md hover:shadow-lg flex items-center justify-between transition active:scale-[0.98]"
              >
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-xl bg-white/20 flex items-center justify-center text-lg shrink-0">
                    <i class="ph-bold ${item.icon}"></i>
                  </span>
                  <span class="text-left leading-snug">${item.name}</span>
                </div>
                <div class="flex items-center gap-1 text-xs bg-white/20 hover:bg-white/30 px-3.5 py-2 rounded-xl font-black shrink-0 ml-2 transition">
                  <span>👉 點此開啟</span>
                </div>
              </a>
            ` : `
              <div class="w-full py-4 px-5 rounded-2xl bg-gradient-to-r ${item.bg} text-white font-black text-base sm:text-lg shadow-md flex items-center justify-between opacity-95 cursor-default">
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-xl bg-white/20 flex items-center justify-center text-lg shrink-0">
                    <i class="ph-bold ${item.icon}"></i>
                  </span>
                  <span class="text-left leading-snug">${item.name}</span>
                </div>
                <span class="text-xs bg-white/20 px-3 py-1.5 rounded-full font-bold shrink-0 ml-2">注意事項</span>
              </div>
            `}

            <!-- 2. 下方白底說明小卡 -->
            <div class="bg-white rounded-2xl p-4 border border-cyan-100 shadow-sm space-y-2 text-xs sm:text-sm">
              
              <!-- 用途說明 -->
              <div class="flex items-start gap-2">
                <span class="font-bold text-slate-400 shrink-0">【用途說明】</span>
                <span class="font-bold text-slate-800 leading-snug">${item.purpose}</span>
              </div>

              <!-- 帳號與一鍵複製 -->
              <div class="flex items-center justify-between gap-2 pt-1.5 border-t border-slate-100">
                <div class="flex items-center gap-1.5 truncate">
                  <span class="font-bold text-slate-400 shrink-0">【帳號規則】</span>
                  <span class="font-mono font-bold text-slate-700 truncate">${item.account}</span>
                </div>
                ${item.copyAccount ? `
                  <button onclick="copy('${item.copyAccount}')" class="touch-btn shrink-0 px-2.5 py-1 rounded-lg bg-cyan-50 hover:bg-cyan-600 text-cyan-800 hover:text-white font-bold text-xs border border-cyan-200 transition">
                    複製 ${item.copyAccount}
                  </button>
                ` : ''}
              </div>

              <!-- 密碼與一鍵複製 -->
              <div class="flex items-center justify-between gap-2 pt-1.5 border-t border-slate-100">
                <div class="flex items-center gap-1.5 truncate">
                  <span class="font-bold text-slate-400 shrink-0">【密碼規則】</span>
                  <span class="font-bold text-amber-900 truncate">${item.password}</span>
                </div>
                ${item.copyPassword ? `
                  <button onclick="copy('${item.copyPassword}')" class="touch-btn shrink-0 px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-600 text-amber-900 hover:text-white font-bold text-xs border border-amber-200 transition">
                    複製密碼
                  </button>
                ` : ''}
              </div>

              <!-- 備註說明 -->
              ${item.notes ? `
                <div class="pt-1.5 border-t border-slate-100 text-[12px] text-slate-500 font-medium">
                  💡 ${item.notes}
                </div>
              ` : ''}

            </div>

          </div>
        `;
      }).join("");
    }

    // 返回首頁
    function goHome() {
      document.getElementById("view-detail").classList.add("hidden");
      document.getElementById("view-home").classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "instant" });
    }

    // 複製文字功能
    function copy(text) {
      try {
        const t = document.createElement("textarea");
        t.value = text;
        t.style.position = "fixed";
        t.style.opacity = "0";
        document.body.appendChild(t);
        t.select();
        document.execCommand("copy");
        document.body.removeChild(t);
        showToast(`已複製：${text}`);
      } catch (e) {
        showToast("複製失敗，請手動複製");
      }
    }

    let toastTimer = null;
    function showToast(msg) {
      const toast = document.getElementById("toast");
      const text = document.getElementById("toast-text");
      text.textContent = msg;

      toast.classList.remove("opacity-0", "translate-y-3");
      toast.classList.add("opacity-100", "translate-y-0");

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "translate-y-3");
      }, 1800);
    }

    // 初始化啟動
    window.addEventListener("DOMContentLoaded", () => {
      renderCompanies();
    });
  </script>

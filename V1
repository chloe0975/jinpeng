        tabProperty.querySelector("div:first-child").className = "w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-2xl shrink-0";
        badgeProperty.className = "text-[11px] font-bold text-teal-100 flex items-center justify-center sm:justify-start gap-1 mt-0.5";
        badgeProperty.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-300 inline-block animate-pulse"></span><span>目前選取中</span>';

